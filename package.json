{
  "name": "quota",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:test": "turbo run db:test",
    "db:seed": "turbo run db:seed",
    "anchor:sync": "cp quota_vault/target/idl/quota_vault.json packages/anchor-client/src/idl/ && cp quota_vault/target/types/quota_vault.ts packages/anchor-client/src/types/",
    "demo:agent": "cd scripts/agent && npm install --silent && npx tsx run-agent.ts",
    "vercel-build": "turbo build && turbo db:deploy"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "class-variance-authority": "^0.7.1",
    "tweetnacl": "^1.0.3"
  }
}
