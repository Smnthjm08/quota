generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company?

  sessions     Session[]
  accounts     Account[]
  createdSeats Seat[]    @relation("SeatCreatedBy")
  updatedSeats Seat[]    @relation("SeatUpdatedBy")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum CompanyStatus {
  PENDING
  ACTIVE
  ON_HOLD
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum PlanInterval {
  ONETIME
  MONTH
}

model Plan {
  id              Int          @id @default(autoincrement())
  key             String       @unique // "starter", "team", "topup_10", "topup_25", "topup_50"
  name            String
  priceCents      Int
  currency        String       @default("USD")
  interval        PlanInterval
  maxAllowedSeats Int?
  initDeposit     Int?
  dodoProductId   String       @unique

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plan")
}

model VaultTopUp {
  id            Int      @id @default(autoincrement())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amountUsdc    Float
  source        String // subscription_activation | subscription_renewal | manual_topup | crypto_deposit
  dodoPaymentId String?
  txSignature   String?
  createdAt     DateTime @default(now())

  @@map("vault_top_up")
}

enum UsageEventType {
  VAULT_CREATED
  VAULT_FUNDED
  SEAT_CREATED
  SEAT_UPDATED
  SEAT_TOGGLED
  API_CONSUMED
}

model UsageEvent {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seatId      String?
  seat        Seat?          @relation(fields: [seatId], references: [id], onDelete: SetNull)
  type        UsageEventType
  title       String
  amountUsdc  Int?
  txSignature String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@map("usage_event")
}

model Subscription {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId Int
  plan   Plan @relation(fields: [planId], references: [id])

  dodoSubscriptionId String             @unique
  dodoCustomerId     String?
  status             SubscriptionStatus

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

model DodoWebhookEvent {
  id           String             @id @default(cuid())
  webhookId    String             @unique
  eventType    String
  payload      Json
  status       WebhookEventStatus @default(PROCESSING)
  errorMessage String?
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dodo_webhook_event")
}

model DodoPayment {
  id             String   @id @default(cuid())
  paymentId      String   @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String?
  subscriptionId String?
  amount         Int?
  currency       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("dodo_payment")
}

model Company {
  id                String  @id @default(cuid())
  name              String
  size              String
  website           String?
  address           String?
  state             String?
  city              String?
  maxAllowedSeats   Int?
  pinCode           String?
  vaultPda          String? @unique
  ownerWalletPubkey String?

  status CompanyStatus @default(PENDING)

  planId Int?
  plan   Plan? @relation(fields: [planId], references: [id])

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  subscription Subscription?
  seats        Seat[]
  vaultTopup   VaultTopUp[]
  dodopayments DodoPayment[]
  usageEvents  UsageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company")
}

enum SeatType {
  HUMAN //1
  AGENT //2
}

model Seat {
  id   String @id @default(cuid())
  name String

  seatType SeatType
  active   Boolean  @default(true)

  holderPubkey String
  seatPda      String @unique

  monthlyLimit Int
  consumed     Int @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  usageEvents UsageEvent[]

  lastSpendAt DateTime?

  createdBy     String
  createdByUser User   @relation("SeatCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  updatedBy     String
  updatedByUser User   @relation("SeatUpdatedBy", fields: [updatedBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // user      User?    @relation(fields: [userId], references: [id])
  // userId    String?

  @@unique([companyId, holderPubkey])
  @@map("seat")
}

model RouteConfig {
  id          String   @id @default(cuid())
  path        String   @unique
  price       Int
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("route_config")
}

